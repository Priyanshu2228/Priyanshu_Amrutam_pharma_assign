# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# --- Data stores ---
DATABASE_URL=postgres://amrutam:amrutam@localhost:5432/amrutam
# Optional read replica; reads fall back to the primary when unset.
DATABASE_REPLICA_URL=
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_ISSUER=amrutam-api
JWT_AUDIENCE=amrutam-clients
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
MFA_REQUIRED_ROLES=doctor,admin

# --- Encryption ---
# Comma-separated keyring "<kid>:<base64 32-byte key>". The FIRST key encrypts; all keys decrypt.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEYS=k1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
AUDIT_HMAC_KEY=change-me-audit-hmac-key-change-me-change-me

# --- Payments ---
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# --- Booking policy ---
SLOT_HOLD_MINUTES=10
REFUND_WINDOW_HOURS=2

# --- Observability ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=amrutam-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# If set, /metrics requires "Authorization: Bearer <token>".
METRICS_TOKEN=

# --- Storage ---
DOCUMENT_STORAGE_DIR=./storage
